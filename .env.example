# Node reads environment variables supplied by your terminal or host.
HOST=127.0.0.1
PORT=8787
# DATABASE_PATH=/absolute/path/runtime.sqlite
# Enable only behind your trusted HTTPS reverse proxy:
TRUST_PROXY=false
# Quản trị viên kiểm duyệt đánh giá (email tài khoản đã đăng ký, cách nhau bởi dấu phẩy).
# Thư mục lưu ảnh đánh giá (mặc định: data/uploads/reviews).
# REVIEW_UPLOAD_DIR=/absolute/path/reviews
